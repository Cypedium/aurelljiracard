DB_URL=jdbc:postgresql://localhost:5432/jiraboard
DB_USERNAME=jiraboard
DB_PASSWORD=<database password>
JWT_SECRET=<long random string, at least 32 bytes>
REFRESH_SECRET=<different long random string, at least 32 bytes>
PORT=8080
CLIENT_URL=http://localhost:3000
# Google sign-in (optional): OAuth client id from Google Cloud Console, same as NEXT_PUBLIC_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=
# Email (registration and verification links) through Resend; empty key = registration answers 503
RESEND_API_KEY=
MAIL_FROM=Aurello <noreply@your-domain.example>
# The frontend's address, for the links in the emails
APP_URL=http://localhost:3000
